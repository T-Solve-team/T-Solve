{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"harnessclaude/hooks/session-context.ts\" --codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"harnessclaude/hooks/session-context.ts\" --codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"harnessclaude/hooks/brainstorm-gate.ts\" --codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"harnessclaude/hooks/privacy-block.ts\" --codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
