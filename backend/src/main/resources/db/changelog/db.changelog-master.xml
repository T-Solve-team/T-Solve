<?xml version="1.0" encoding="UTF-8"?>
<!-- Liquibase entry point. Add each new changeset file below, in order; never edit an applied one. -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <include file="changes/001-init-core-schema.sql" relativeToChangelogFile="true"/>
    <include file="changes/003-ticket-import-schema.sql" relativeToChangelogFile="true"/>
    <include file="changes/004-identity-sign-in-states.sql" relativeToChangelogFile="true"/>

</databaseChangeLog>
