# Copy to .env.local. VITE_* values are built into the browser bundle - never put secrets here.

# true = every API call is answered by MSW mocks (no backend needed); false = real backend
VITE_API_MOCKING=true

# There is no API base URL: the app calls /api/v1/... on the page's own origin, and the Host of the page decides
# the Workspace. Against the real backend open http://<site name>.localhost:5173 (the dev server proxies /api to
# http://localhost:8080 and keeps the Host header).
