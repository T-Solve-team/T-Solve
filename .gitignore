# ---- Backend (Java / Maven) ----
target/
build/
out/
*.class
*.log
.codegraph/

# ---- Frontend (frontend/.gitignore has the rest) ----
node_modules/
dist/
coverage/

# ---- Secrets: never commit them (DevOps design §6) ----
# Real values live in GitHub Actions secrets and in the .env files on the server.
.env
.env.*
!.env.example
*.pem
*.key

# ---- Database dumps (they hold personal data) ----
*.dump
*.sql.gz
backups/

# ---- IDE / OS ----
.idea/
.vscode/
*.iml
.claude/settings.local.json
.DS_Store
Thumbs.db

# ---- AI agents ----
prompts/
# Backend prompt files are ignored unless listed by name below: add a line for each new prompt file.
!/backend/src/main/resources/prompts/
/backend/src/main/resources/prompts/*
!/backend/src/main/resources/prompts/wiki-document-type.txt
.claude/worktrees/
