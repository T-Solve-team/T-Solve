# Backend settings. Copy to .env (git-ignored) and fill in every value; the backend reads .env from
# the repo root or backend/ and refuses to start while a name is missing. Never commit real values.
# Local database: use the values docker-compose.yml gives the db service.

# PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis (the docker-compose.yml redis service). Local: host localhost, port 6379, your own password (never commit it)
# REDIS_PASSWORD must not contain spaces or $ (docker-compose.yml uses it in the redis command:)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# HTTP
SERVER_PORT=
# Comma-separated origins allowed to call /api/** (the frontend dev server)
CORS_ALLOWED_ORIGINS=

# Central sign-in (Google). The app refuses to start while one of these is empty or invalid.
# Origins with a scheme and no path (see the local value below)
TSOLVE_LOGIN_ORIGIN=
TSOLVE_ADMIN_ORIGIN=
# Local: TSOLVE_LOGIN_ORIGIN=http://localhost:8180 (Keycloak). It now serves both the old login. host and Keycloak, so the old local sign-in does not work with it until Task 23b.
# Comma-separated emails allowed into the Platform Console (compared ignoring case)
PLATFORM_OPERATOR_EMAILS=
# Secret of the Keycloak client tsolve-web: Keycloak (realm import) and the backend read the same value. Never commit a real one.
KEYCLOAK_WEB_CLIENT_SECRET=
# Secret of the Keycloak client tsolve-console (realm tsolve-ops, the Platform Console sign-in): Keycloak and the backend read the same value. Never commit a real one.
KEYCLOAK_CONSOLE_CLIENT_SECRET=
# Provisioning of a Workspace's Keycloak sign-in. Read only by the `ops` profile (never a Workspace web process):
# with one of the first three empty the provisioning is off and a WARN names it. Never commit a real value.
# Secret of the Keycloak client tsolve-provisioner (the realm import reads the same value)
KEYCLOAK_ADMIN_CLIENT_SECRET=
# The Google OAuth client every Workspace identity provider uses. Local: any placeholder
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Origin of a Workspace site for its two tsolve-web URIs, {slug} replaced. Local: http://{slug}.localhost:8080
# Production: https://{slug}.tsolve.io.vn
TSOLVE_SITE_ORIGIN_TEMPLATE=
# Password of the Keycloak database user (created by the keycloak-db-init service). Not for production.
KEYCLOAK_DB_PASSWORD=
# Optional: remove the leading # to change it. Cron of the session expiry sweep; default every minute, "-" turns it off.
# An empty value is not valid, so leave the line commented to keep the default.
# TSOLVE_SESSION_SWEEP_CRON=0 * * * * *

# Stand-in for Projects until the workspace module exists (not secret). Format: user:projectId,projectId;user:projectId
# (Project ids are UUIDs). Empty = nobody can import. Example: pm@company.vn:00000000-0000-0000-0000-000000000001
TSOLVE_STUB_PROJECTS=
# Comma-separated Project UUIDs to treat as removed (MSG40)
TSOLVE_STUB_INACTIVE_PROJECTS=
# Jira project of each stub Project, for Jira import. Format: <project uuid>:<Jira project>, comma-separated
TSOLVE_STUB_JIRA_KEYS=
# AI Solution Suggestion: cosine similarity (0 to 1) a source needs; default 0.7
SUGGESTION_MIN_SIMILARITY=0.7
# Dev and mock only: Workspace UUID the tracker binds when it enqueues a suggestion job on the worker (one of
# TSOLVE_MOCK_ACTIVE_WORKSPACES). Empty = jobs are not queued while no Workspace is bound.
TSOLVE_TRACKER_DEV_WORKSPACE_ID=
# Stand-in for the Workspace's Jira service account until the workspace module stores it (UC-08/09): the tracker
# posts the MSG80 suggestion comment with it (STORY-012). Any of the three empty = no comment is posted.
# JIRA_SITE_URL=https://<your-site>.atlassian.net ; the email and an API token of the Jira account T-Solve uses.
JIRA_SITE_URL=
JIRA_SERVICE_ACCOUNT_EMAIL=
JIRA_SERVICE_ACCOUNT_TOKEN=

# KAN-102: optional JobRunr integration. Jobs must use a separate PostgreSQL database.
# Integration is off by default. The worker Spring profile enables enqueue/storage AND processing.
# To enqueue only from the web process, set TSOLVE_WORKER_ENABLED=true without the worker profile.
TSOLVE_WORKER_ENABLED=false
JOBS_DB_URL=
JOBS_DB_USER=
JOBS_DB_PASSWORD=
# TSOLVE_WORKER_COUNT=4
# Temporary platform adapter: explicitly activate worker-mock; comma-separated UUIDs, empty denies all.
TSOLVE_MOCK_ACTIVE_WORKSPACES=
TSOLVE_MOCK_SUSPENDED_WORKSPACES=

# Jira App (Forge)
# The Forge app's id (ari:cloud:ecosystem::app/<uuid>), from `forge register` / the developer console
TSOLVE_JIRA_APP_ID=
# Forge's JWKS for verifying FIT tokens: https://forge.cdn.prod.atlassian-dev.net/.well-known/jwks.json
FORGE_JWKS_URI=
# "Ask T-Solve" page: stub links of Jira accounts to T-Solve Accounts until identity's JiraAccountLinkLookup,
# as <Jira accountId>=<Account uuid>;… (the Account must be ACTIVE; anyone else is not linked)
TSOLVE_STUB_JIRA_ASKERS=
# Deadline for one question from the Jira App, under Forge's 25 s limit (AC-010.8)
JIRA_APP_ASK_TIMEOUT=18s
# Questions from the Jira App answered at once (as many more may wait); beyond that MSG06 (BUG-183)
JIRA_APP_ASK_THREADS=8

# AI server (Ollama on the AI VPS). No default for the first two: the backend refuses to start without them.
OLLAMA_BASE_URL=
OLLAMA_CHAT_MODEL=
# Optional: remove the leading # to change one (defaults shown). Embedding model, connect / chat / embed timeouts,
# concurrent calls per backend process, and how long a further call waits for a free slot.
# OLLAMA_EMBED_MODEL=bge-m3
# AI_CONNECT_TIMEOUT=2s
# AI_CHAT_TIMEOUT=60s
# AI_EMBED_TIMEOUT=10s
# AI_MAX_CONCURRENT=2
# AI_PERMIT_WAIT=1s

# Review notifications. Example for Resend SMTP using STARTTLS on the worker process.
# Verify the sender domain first and set the API key as a deployment secret.
# SPRING_MAIL_HOST=smtp.resend.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=resend
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_CHECKSERVERIDENTITY=true
# TSOLVE_SMTP_FROM=
# Optional timeout overrides, in milliseconds.
# SMTP_CONNECT_TIMEOUT_MS=5000
# SMTP_READ_TIMEOUT_MS=3000
# SMTP_WRITE_TIMEOUT_MS=5000

# Search scope: empty fails closed until membership adapters are available.
# Set exactly all only for a local demo; never enable it in deployment.
SEARCH_DEV_SCOPE=
# Maximum number of tickets in one embedding batch.
SEARCH_EMBED_BATCH=4
# Delay after each embedding catch-up run finishes.
SEARCH_EMBED_CATCH_UP_DELAY=60s
# Minimum cosine similarity for semantic ticket search.
SEARCH_MIN_SIMILARITY=0.5

# Chatbot retrieval threshold, total kept sources and deadline for an ask.
CHATBOT_MIN_SIMILARITY=0.7
CHATBOT_SOURCE_LIMIT=5
CHATBOT_ASK_TIMEOUT=60s

# Jira import (UC-20): the Workspace's Jira service account, until the workspace module stores it. Empty = a pull
# answers MSG50 "not configured". The site must be https, e.g. https://<site>.atlassian.net
# Use the Workspace service account's scoped API token, sent as Bearer through api.atlassian.com.
# Find the cloud id at https://<site>.atlassian.net/_edge/tenant_info. JIRA_SITE_URL (set above, shared with the
# tracker) is only for browse links here.
JIRA_CLOUD_ID=
JIRA_API_TOKEN=
