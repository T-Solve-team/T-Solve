# Backend settings. Copy to .env (git-ignored) and fill in every value; the backend reads .env from
# the repo root or backend/ and refuses to start while a name is missing. Never commit real values.
# Local database: use the values docker-compose.yml gives the db service.

# PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# HTTP
SERVER_PORT=
# Comma-separated origins allowed to call /api/** (the frontend dev server)
CORS_ALLOWED_ORIGINS=
