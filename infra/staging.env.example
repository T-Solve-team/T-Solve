# T-Solve staging: the one env file of the stack. Copy to /srv/tsolve/staging/.env on the VPS, chmod 600, never commit.
# Compose reads it with `--env-file` (for the ${...} in infra/compose.staging.yml) and hands it to the backend
# containers (`env_file:`). Do not quote values, and do not put a space or a $ in a password.
#
# Legend:  [GEN]  a secret you generate:  openssl rand -hex 32
#          [FILL] you fill it in (domain, Google, emails, Jira)
#          the rest has a safe default shown, or is derived from the domain: replace <domain> / <slug> yourself.

# ---------------------------------------------------------------------------------------------------------------
# Domain and sites (caddy, keycloak, backend)
# ---------------------------------------------------------------------------------------------------------------
# [FILL] Base domain, e.g. tsolve.io.vn. Hosts login., admin., api. and each company site live under it.
TSOLVE_DOMAIN=
# [FILL] Company site hosts, SPACE-separated (a comma without a space is rejected by Caddy); exactly ONE company on this stack:
# TSOLVE_SITE_HOSTS=acme.<domain>
TSOLVE_SITE_HOSTS=
# [FILL] Optional Let's Encrypt contact email
ACME_EMAIL=
# https://login.<domain> and https://admin.<domain> (no path, no trailing slash)
TSOLVE_LOGIN_ORIGIN=
TSOLVE_ADMIN_ORIGIN=
# https://<slug>.<domain>,https://admin.<domain>
CORS_ALLOWED_ORIGINS=
# https://{slug}.<domain>   ({slug} is replaced by the backend, keep it literally)
TSOLVE_SITE_ORIGIN_TEMPLATE=
# [FILL] Comma-separated emails allowed into the Platform Console
PLATFORM_OPERATOR_EMAILS=

# ---------------------------------------------------------------------------------------------------------------
# The demo company (Keycloak realm import + TSOLVE_STUB_WORKSPACES). Change the realm later in the Admin Console:
# the import runs once and then skips an existing realm (see infra/keycloak/staging/README.md).
# ---------------------------------------------------------------------------------------------------------------
# [FILL] Slug of the company, e.g. acme (its site is https://<slug>.<domain>)
TSOLVE_DEMO_SLUG=
# [FILL] Google Workspace domain of the company (the Google `hd` claim), e.g. acme.com
TSOLVE_DEMO_GOOGLE_DOMAIN=
# [GEN] Fixed UUID of the company's Keycloak Organization:  uuidgen   (or: cat /proc/sys/kernel/random/uuid)
TSOLVE_DEMO_ORG_ID=
# [GEN] The Workspace UUID (same method). It appears THREE times, with the same value:
#   TSOLVE_STUB_WORKSPACES      siteHost|slug|<workspace uuid>|googleDomain|<TSOLVE_DEMO_ORG_ID>
#   TSOLVE_MOCK_ACTIVE_WORKSPACES   <workspace uuid>
#   TSOLVE_TRACKER_DEV_WORKSPACE_ID <workspace uuid>
# TSOLVE_STUB_WORKSPACES, 5 fields separated by "|": <slug>.<domain>|<slug>|<workspace uuid>|<google domain>|<org id>
# Field 3 = the Workspace UUID; field 4 = TSOLVE_DEMO_GOOGLE_DOMAIN; field 5 = TSOLVE_DEMO_ORG_ID.
# Exactly one entry on this stack: all companies would share the one app database, so the backend refuses to start
# with more than one entry.
TSOLVE_STUB_WORKSPACES=
TSOLVE_MOCK_ACTIVE_WORKSPACES=
TSOLVE_MOCK_SUSPENDED_WORKSPACES=
TSOLVE_TRACKER_DEV_WORKSPACE_ID=

# ---------------------------------------------------------------------------------------------------------------
# Google (one OAuth client for every company and the operators). Redirect URIs: infra/keycloak/staging/README.md
# ---------------------------------------------------------------------------------------------------------------
# [FILL]
GOOGLE_CLIENT_ID=
# [FILL]
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------------------------------------------
# Keycloak client secrets (the realm import and the backend read the same values)
# ---------------------------------------------------------------------------------------------------------------
# [GEN]
KEYCLOAK_WEB_CLIENT_SECRET=
# [GEN]
KEYCLOAK_CONSOLE_CLIENT_SECRET=
# [GEN]
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Optional: where "Back to sign-in" points. Default https://<slug>.<domain>/
# TSOLVE_WEB_BASE_URL=

# ---------------------------------------------------------------------------------------------------------------
# PostgreSQL. The init script (infra/postgres/init) creates these databases and users, once, on an EMPTY volume.
# ---------------------------------------------------------------------------------------------------------------
# [GEN] Superuser `postgres` (only the init script uses it)
POSTGRES_PASSWORD=
# App database (the backend sets DB_HOST=db and DB_PORT=5432 itself)
DB_NAME=tsolve
DB_USER=tsolve
# [GEN]
DB_PASSWORD=
# Keycloak database
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
# [GEN]
KEYCLOAK_DB_PASSWORD=
# JobRunr database (separate from the app database); JOBS_DB_URL must name JOBS_DB_NAME
JOBS_DB_NAME=tsolve_staging_jobs
JOBS_DB_USER=tsolve_jobs
# [GEN]
JOBS_DB_PASSWORD=
JOBS_DB_URL=jdbc:postgresql://db:5432/tsolve_staging_jobs
# Tuning of the db container
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1GB

# ---------------------------------------------------------------------------------------------------------------
# Redis (the backend sets REDIS_HOST=redis, REDIS_PORT=6379 itself)
# ---------------------------------------------------------------------------------------------------------------
# [GEN] hex only: no spaces, no $
REDIS_PASSWORD=
# The backend containers need the next two names; compose overrides them with db / redis / 8080
DB_HOST=db
DB_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
SERVER_PORT=8080

# ---------------------------------------------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------------------------------------------
# [FILL] The Forge app id (ari:cloud:ecosystem::app/<uuid>) and Forge's keys
TSOLVE_JIRA_APP_ID=
FORGE_JWKS_URI=https://forge.cdn.prod.atlassian-dev.net/.well-known/jwks.json
# Workers: JobRunr in the worker container (compose sets TSOLVE_WORKER_ENABLED=true and the profiles)
TSOLVE_WORKER_COUNT=4
# Must stay EMPTY on a deployment (fails closed). Never set it to "all".
SEARCH_DEV_SCOPE=
SEARCH_EMBED_BATCH=4
SEARCH_EMBED_CATCH_UP_DELAY=60s
SEARCH_MIN_SIMILARITY=0.5
CHATBOT_MIN_SIMILARITY=0.7
CHATBOT_SOURCE_LIMIT=5
CHATBOT_ASK_TIMEOUT=60s
JIRA_APP_ASK_TIMEOUT=18s
JIRA_APP_ASK_THREADS=8
# Stand-ins until the workspace module exists (empty = off)
TSOLVE_STUB_PROJECTS=
TSOLVE_STUB_INACTIVE_PROJECTS=
TSOLVE_STUB_JIRA_KEYS=
TSOLVE_STUB_SUGGESTION=
TSOLVE_STUB_JIRA_ASKERS=
# [FILL] Optional: the Workspace's Jira service account (suggestion comments) and the Jira import
JIRA_SITE_URL=
JIRA_SERVICE_ACCOUNT_EMAIL=
JIRA_SERVICE_ACCOUNT_TOKEN=
JIRA_CLOUD_ID=
JIRA_API_TOKEN=

# ---------------------------------------------------------------------------------------------------------------
# AI (Ollama runs in this stack at http://ollama:11434)
# ---------------------------------------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
# [FILL] Chat model to pull and use, e.g. qwen2.5:7b
OLLAMA_CHAT_MODEL=
OLLAMA_EMBED_MODEL=bge-m3
AI_CONNECT_TIMEOUT=2s
AI_CHAT_TIMEOUT=60s
AI_EMBED_TIMEOUT=10s
AI_MAX_CONCURRENT=2
AI_PERMIT_WAIT=1s

# ---------------------------------------------------------------------------------------------------------------
# Notifications (worker). Leave SPRING_MAIL_HOST empty to send no email; with a host, TSOLVE_SMTP_FROM is required.
# ---------------------------------------------------------------------------------------------------------------
# SPRING_MAIL_HOST=smtp.resend.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=resend
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
# TSOLVE_SMTP_FROM=

# ---------------------------------------------------------------------------------------------------------------
# First admin (read only by infra/scripts/seed-first-admin.sh)
# ---------------------------------------------------------------------------------------------------------------
# [FILL] An email on the company's Google domain, and the name shown
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_NAME=

# ---------------------------------------------------------------------------------------------------------------
# Compose only: memory limits (sized for a 16 GB VPS: total 12.4 GB) and the env file path
# ---------------------------------------------------------------------------------------------------------------
DB_MEM_LIMIT=2g
KEYCLOAK_MEM_LIMIT=1536m
BACKEND_MEM_LIMIT=1536m
WORKER_MEM_LIMIT=1g
OLLAMA_MEM_LIMIT=6g
REDIS_MEM_LIMIT=192m
CADDY_MEM_LIMIT=128m
WEB_MEM_LIMIT=64m
# Only when the file is not /srv/tsolve/staging/.env: also export it in your shell before running compose.
# TSOLVE_ENV_FILE=/srv/tsolve/staging/.env
